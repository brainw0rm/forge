# Copy to .env.local (dev) or set in Cloudflare Pages → Settings → Environment variables (build).
# Leave empty to show Forever Forge's own promos in the ad slots.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
# Optional 300×600 sidebar unit; defaults to the rectangle unit.
VITE_ADSENSE_SLOT_RAIL=
# Without AdSense: "placeholder" (default) shows labeled ad-space boxes, "house" shows site promos.
VITE_AD_FALLBACK=
