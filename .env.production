# Production build settings (committed on purpose; these values are public anyway, no secrets here).

# Public address, used for the sitemaps.
VITE_SITE_URL=https://wow-forever-forge.com
# AdSense publisher ID: puts the AdSense script in the page head and writes ads.txt.
VITE_ADSENSE_CLIENT=ca-pub-1885032554164263

# Ko-fi page for the "Support" links (hidden while empty).
VITE_KOFI_URL=

# Until the ad units exist (VITE_ADSENSE_SLOT_LEADERBOARD / _RECTANGLE / _RAIL), slots show the
# site's own promos instead of "Ad space" boxes. Remove this line once the slot IDs are added.
VITE_AD_FALLBACK=house
